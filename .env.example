# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose.yml defaults)
POSTGRES_DB=wearlydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (used by Celery)
REDIS_URL=redis://localhost:6379/0

# Email (defaults to console output for local development)
# For production, set EMAIL_BACKEND=core.email_backend.ResendEmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Resend (only needed if EMAIL_BACKEND=core.email_backend.ResendEmailBackend)
RESEND_API_KEY=

# Cloudinary (optional for local dev - images stored locally in media/ without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
